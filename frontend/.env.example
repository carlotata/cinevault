# Default for web browser development (uses Vite proxy in vite.config.js)
VITE_API_BASE_URL=/api

# For Android Emulator development (host machine loopback):
# VITE_API_BASE_URL=http://10.0.2.2:8000/api

# For Physical Device testing on local Wi-Fi (replace with your machine's LAN IP):
# VITE_API_BASE_URL=http://192.168.1.100:8000/api
